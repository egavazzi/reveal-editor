{
  "name": "reveal-editor",
  "version": "0.1.0",
  "description": "Local WYSIWYG editor for reveal.js presentations. Decks stay plain, hand-editable HTML.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "reveal-editor": "bin/reveal-editor.js"
  },
  "scripts": {
    "edit": "node bin/reveal-editor.js",
    "new": "node bin/reveal-editor.js new",
    "dev": "node bin/reveal-editor.js --dev",
    "build": "vite build",
    "vendor": "node scripts/vendor.js",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "express": "^5.1.0",
    "open": "^10.1.0",
    "parse5": "^7.2.1",
    "postcss": "^8.5.17"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "happy-dom": "^20.11.2",
    "katex": "^0.16.21",
    "moveable": "^0.53.0",
    "reveal.js": "^5.2.1",
    "selecto": "^1.26.3",
    "svelte": "^5.20.0",
    "svelte-dnd-action": "^0.9.61",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
